# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Telegram API (получить на https://my.telegram.org)
# нужны для Local Bot API (контейнер bot-api)
API_ID=
API_HASH=

# Юзернейм бота (без @) — используется в подписи к медиа
BOT_USERNAME=your_bot_username

# ==================== БАЗА ДАННЫХ ====================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_youtube
DB_USER=bot_4_youtube
DB_PASSWORD=

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую (получат алерты о падении источников)
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== ПРОКСИ ====================

# Резидентный SOCKS5 прокси. При WARP_PRIMARY=true (дефолт) — только fallback В КОНЦЕ цепочки.
# Формат: socks5://user:pass@host:port  или  socks5://host:port. Пусто = не используется.
PROXY_URL=

# ==================== WARP-ПУЛ + PO-TOKEN ====================

# PO-token провайдер (контейнер bgutil) — снимает "Sign in to confirm you're not a bot"
# без cookies. Пусто = выключить PO-token.
BGUTIL_BASE_URL=http://bgutil:4416

# WARP-пул: WARP_PRIMARY=true — WARP основной источник, резидентный прокси уходит в конец.
WARP_PRIMARY=true
# Размер пула должен совпадать с числом warpN сервисов в docker-compose.yml (сейчас 5).
WARP_POOL_SIZE=5
# Сколько разных WARP-IP перебрать в одной попытке скачивания перед уходом на proxy/cookies.
WARP_MAX_TRIES=3
# Явный список эндпоинтов (через запятую) переопределяет автосписок warp1..warpN:9091.
# WARP_PROXIES=socks5://warp1:9091,socks5://warp2:9091
# Сколько секунд держать WARP-эндпоинт вне ротации после блокировки его IP (ip_blocked).
WARP_COOLDOWN_SECONDS=1800

# ==================== ЛИМИТЫ И КЭШ ====================

# Кэш скачиваний в БД (дни) — не перекачиваем одно и то же видео
CACHE_TTL_DAYS=1

# ==================== БАЛАНСИРОВКА ПРОКСИ/WARP ====================

# Порог размера для маршрутизации (МБ):
# видео < порога → через WARP (разгружаем прокси от мелких файлов)
# видео ≥ порога → через прокси (быстрый путь для HD)
SMALL_VIDEO_THRESHOLD_MB=30

# Префлайт-фильтр: качества с оценкой > этого порога не показываются юзеру
# (оценка yt-dlp обычно завышена; 2000 — с запасом от лимита 2 ГБ и разгружает сервер от тяжёлых загрузок)
MAX_QUALITY_SIZE_MB=2000
